{
  "name": "claude-master-skills",
  "version": "1.3.0",
  "description": "Skills, subagents, hooks & CLAUDE.md templates for the Next.js/TypeScript/Vercel stack",
  "author": "PierDeRogatis",
  "license": "MIT",
  "bin": {
    "claude-master-skills": "./bin/install.js"
  },
  "scripts": {
    "install-skills": "node bin/install.js",
    "test": "node --test $(find tests -name '*.test.js' -type f | sort)",
    "test:hooks": "node --test $(find tests/hooks -name '*.test.js' -type f | sort)",
    "test:installer": "node --test $(find tests/installer -name '*.test.js' -type f | sort)",
    "test:templates": "node --test $(find tests/templates -name '*.test.js' -type f | sort)"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "agents",
    "hooks",
    "nextjs",
    "typescript",
    "vercel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PierDeRogatis/claude-master-skills.git"
  }
}
